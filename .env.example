# ── Required ────────────────────────────────────────────────────────────────
# One Groq key covers both transcription (Whisper) and structuring (Llama).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Port the import server listens on.
PORT=8787

# Models (override only if you want to).
STRUCTURE_MODEL=llama-3.3-70b-versatile
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Fetch chain ─────────────────────────────────────────────────────────────
# Social links are resolved cheapest-first:
#   1. yt-dlp        free. Works from residential IPs, and today for Instagram
#                    from our host too.
#   2. YouTube page  free. YouTube bot-walls yt-dlp from datacenter IPs, but the
#                    watch page still yields the description. YouTube only.
#   3. Apify         paid. Only billed when the free tiers above fail.
# If all three fail the app offers "paste the caption instead".

# Managed scraper token — https://console.apify.com
# Without it the paid tier is simply skipped (free tiers + manual paste only).
APIFY_TOKEN=

# Actor ids (override to pin a different/known-good scraper).
APIFY_IG_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper
APIFY_YT_ACTOR=streamers~youtube-scraper

# How long each tier may take before we fall through to the next.
YTDLP_TIMEOUT_MS=25000
APIFY_TIMEOUT_MS=90000
# Hard cap on a whole import (scrape + transcribe + structure).
IMPORT_TIMEOUT_MS=120000

# ── yt-dlp hardening (optional) ─────────────────────────────────────────────
# A residential/mobile proxy is the single biggest lever for making yt-dlp work
# from a server — it fixes YouTube's datacenter-IP bot wall outright.
#   e.g. http://user:pass@gate.smartproxy.com:7000
YTDLP_PROXY=

# Path to a cookies.txt (a logged-in session export). Helps for Instagram.
YTDLP_COOKIES=

# ── Cache (the biggest cost control) ────────────────────────────────────────
# Recipes are shared content: one viral reel imported by 5,000 users should cost
# ONE scrape. Set DATABASE_URL (Railway → New → Database → Postgres) and the
# cache survives restarts and is shared across instances. Without it the cache
# is in-memory and resets on every deploy.
DATABASE_URL=

CACHE_TTL_MS=2592000000     # 30 days
CACHE_MAX_ENTRIES=5000      # in-memory LRU bound
PGPOOL_MAX=5
# PGSSL=disable             # only for a local postgres without TLS

# ── Abuse / spend protection ────────────────────────────────────────────────
# Every uncached import costs money, so the endpoints are rate limited per
# client (x-device-id header, falling back to IP).
RATE_LIMIT_BURST=10         # requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DAILY=100        # imports per client per day

# Comma-separated origins for the browser build. Empty = allow all (fine for a
# native app; lock it down if you ship a web client).
ALLOWED_ORIGINS=

# ── Required ────────────────────────────────────────────────────────────────
# One Groq key covers both transcription (Whisper) and structuring (Llama).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Port the import server listens on.
PORT=8787

# Models (override only if you want to).
STRUCTURE_MODEL=llama-3.3-70b-versatile
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Managed scraper (Instagram / TikTok) ────────────────────────────────────
# The core feature. Self-hosted yt-dlp gets blocked from cloud IPs, so social
# links are fetched via a managed scraper first. Default provider is Apify.
#   1. Sign up at https://console.apify.com and create an API token.
#   2. Paste it below. Without it, IG/TikTok fall back to yt-dlp (often blocked)
#      and then to the in-app "paste the caption" manual flow.
APIFY_TOKEN=

# Actor ids (override to pin a different/known-good scraper).
APIFY_IG_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper

# ── yt-dlp fallback (YouTube, and IG/TikTok if you self-host that path) ──────
# A residential/mobile proxy is the biggest lever for making yt-dlp work from a
# server. Optional — leave blank for plain yt-dlp.
#   e.g. http://user:pass@gate.smartproxy.com:7000
YTDLP_PROXY=

# Path to a cookies.txt (a logged-in session export). Effectively required for
# most Instagram content via yt-dlp. Optional.
YTDLP_COOKIES=
